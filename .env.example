# Copy to .env and fill values

# Razorpay — TEST mode keys (rzp_test_...) until KYC is complete.
# Switching to LIVE is env-only: replace with rzp_live_* values (no code changes).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Hidden admin API. Generate once per environment:
#   ADMIN_ROUTE_PREFIX="/ops-$(openssl rand -hex 12)"
#   ADMIN_JWE_SECRET="$(openssl rand -base64 48)"
#   ADMIN_OTP_PEPPER="$(openssl rand -base64 48)"
ADMIN_ROUTE_PREFIX=
ADMIN_JWE_SECRET=
ADMIN_OTP_PEPPER=
ADMIN_SESSION_EXPIRE_MINUTES=30
ADMIN_OTP_EXPIRE_MINUTES=10

# Firebase Cloud Messaging (push notifications)
PUSH_NOTIFICATIONS_ENABLED=false
FIREBASE_PROJECT_ID=
FCM_ALL_USERS_TOPIC=all_users
#
# Local/dev: point at a file (keep it under storage/ which is gitignored):
#   FIREBASE_CREDENTIALS_PATH=storage/firebase-service-account.json
#
# Render/production: paste the FULL service-account JSON as ONE LINE.
# Do NOT commit the JSON file. Do NOT use multi-line JSON in env.
# Generate the one-liner locally:
#   python -c "import json; print(json.dumps(json.load(open('storage/firebase-service-account.json'))))"
# Then set in Render dashboard:
#   FIREBASE_CREDENTIALS_JSON=<that one-line output>
# Leave FIREBASE_CREDENTIALS_PATH empty on Render.
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=

# Set true only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false
