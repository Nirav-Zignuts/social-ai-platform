# Copy to .env and fill values

# Razorpay — TEST mode keys (rzp_test_...) until KYC is complete.
# Switching to LIVE is env-only: replace with rzp_live_* values (no code changes).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Hidden admin API. Generate once per environment:
#   ADMIN_ROUTE_PREFIX="/ops-$(openssl rand -hex 12)"
#   ADMIN_JWE_SECRET="$(openssl rand -base64 48)"
#   ADMIN_OTP_PEPPER="$(openssl rand -base64 48)"
ADMIN_ROUTE_PREFIX=
ADMIN_JWE_SECRET=
ADMIN_OTP_PEPPER=
ADMIN_SESSION_EXPIRE_MINUTES=30
ADMIN_OTP_EXPIRE_MINUTES=10

# Firebase Cloud Messaging (push notifications)
# Set PUSH_NOTIFICATIONS_ENABLED=true after adding a service-account JSON.
PUSH_NOTIFICATIONS_ENABLED=false
# Prefer JSON string on PaaS (Render). Escape newlines as \n inside the JSON.
FIREBASE_CREDENTIALS_JSON=
# Or path to the downloaded service-account file (local/dev).
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=
# Topic every registered device is subscribed to (admin all-user broadcasts).
FCM_ALL_USERS_TOPIC=all_users

# Set true only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false
